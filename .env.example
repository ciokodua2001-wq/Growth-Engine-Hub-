# GrowthForge — required environment variables.
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Environment ---
# "development" activates the dev-only requireDevAccess middleware and the
# dev.usegrowthforge.com Basic Auth + banner treatment — see docs/deployment.md.
# Leave unset (or "production") for local/prod work.
APP_ENV=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same URL/anon key, re-exposed with the VITE_ prefix for the Vite frontends.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pooled "Transaction mode" connection string (port 6543) — used by the app at runtime.
DATABASE_URL=
# Direct connection string (port 5432) — used only for running drizzle-kit push migrations.
DIRECT_DATABASE_URL=

# --- Supabase Storage buckets ---
# All three below point at the SAME Supabase Storage bucket (create it once via
# supabase.storage.createBucket(), non-public — access is via signed URLs, not
# bucket-level public reads). PUBLIC_OBJECT_SEARCH_PATHS/PRIVATE_OBJECT_DIR are
# just path prefixes *within* that bucket, e.g. "growthforge/dev/public".
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google AI (Gemini + Imagen text/image generation, Cloud TTS narration) ---
# GOOGLE_GENAI_API_KEY alone is enough for Gemini/Imagen (Gemini Developer API).
# Cloud TTS narration needs a full service account: set GOOGLE_CLOUD_PROJECT_ID +
# GOOGLE_APPLICATION_CREDENTIALS_JSON_STRING (the *entire* service-account key
# JSON file contents, minified to one line) instead of/in addition to the key above.
GOOGLE_GENAI_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON_STRING=

# --- Video generation (self-hosted Wan 2.2 worker on Vast.ai, replacing Kling AI) ---
# Wan 2.2 (14B, T2V-A14B + I2V-A14B) is the real open-weight (Apache 2.0),
# self-hostable model family — verified live on Hugging Face under
# Comfy-Org/Wan_2.2_ComfyUI_Repackaged. Wan 2.7 is API-only (no open weights
# published anywhere as of this writing) — do not substitute it here.
# GPU sizing: a 24GB-class GPU (RTX 4090/5090, A5000, L4-24GB) is sufficient
# with ComfyUI's fp8-scaled sequential expert-swap workflow — NOT an A100 80GB
# (that figure only applies to naive/simultaneous loading of both experts).
# ACTIVE_VIDEO_PROVIDER selects the renderer: "wan" (default, self-hosted GPU worker)
# or "kling" (legacy fallback, requires KLING_API_KEY below).
ACTIVE_VIDEO_PROVIDER=wan
VAST_AI_API_KEY=
# The Vast.ai serverless endpoint NAME (the `endpoint` field in /route/ calls) —
# filled in once the endpoint is provisioned via infra/vast-ai/wan22-provisioning.sh.
VAST_AI_ENDPOINT_ID=
# Optional tuning (sane defaults are hardcoded in wanRenderer.ts if unset):
# VAST_AI_REQUEST_COST=6000
# VAST_AI_MAX_WAIT_SEC=600

# Supabase Storage S3-compatible access keys — generate once via Supabase
# Dashboard → Storage → Settings → S3 Access Keys. Lets the Vast.ai worker
# upload rendered clips directly into our own bucket (no separate download/
# re-upload hop through our server for the raw asset transfer).
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_REGION=us-east-1

KLING_API_KEY=

# --- Security ---
TOKEN_ENCRYPTION_KEY=

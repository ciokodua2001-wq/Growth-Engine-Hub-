# GrowthForge - required environment variables.
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Environment ---
# "development" activates the dev-only requireDevAccess middleware and the
# dev.usegrowthforge.com Basic Auth + banner treatment - see docs/deployment.md.
# Leave unset (or "production") for local/prod work.
APP_ENV=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same URL/anon key, re-exposed with the VITE_ prefix for the Vite frontends.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pooled "Transaction mode" connection string (port 6543) - used by the app at runtime.
DATABASE_URL=
# Direct connection string (port 5432) - used only for running drizzle-kit push migrations.
DIRECT_DATABASE_URL=

# --- Object storage (S3-compatible: Wasabi / R2 / S3 / B2) ---
# All three below point at the SAME private bucket (access via presigned URLs,
# never bucket-level public reads). PUBLIC_OBJECT_SEARCH_PATHS/PRIVATE_OBJECT_DIR
# are path prefixes *within* that bucket - the bucket name is the first segment.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=growthforge-media
PUBLIC_OBJECT_SEARCH_PATHS=growthforge-media/public
PRIVATE_OBJECT_DIR=growthforge-media/private

# Provider-neutral S3 endpoint/region/credentials (Wasabi shown; swap for R2/S3/B2).
# Wasabi ca-central-1 (Toronto): endpoint https://s3.ca-central-1.wasabisys.com
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=false   # default: path-style (true)

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Nigeria / Paystack (TEST keys during development - never commit live keys)
PAYSTACK_SECRET_KEY=
# Optional override for isolated tests (defaults to https://api.paystack.co)
#PAYSTACK_BASE_URL=
# Optional: force the Nigeria region in isolated test environments (no ng.* DNS)
#APP_REGION=nigeria

# --- Google AI (Gemini + Imagen text/image generation, Cloud TTS narration) ---
# GOOGLE_GENAI_API_KEY alone is enough for Gemini/Imagen (Gemini Developer API).
# Cloud TTS narration needs a full service account: set GOOGLE_CLOUD_PROJECT_ID +
# GOOGLE_APPLICATION_CREDENTIALS_JSON_STRING (the *entire* service-account key
# JSON file contents, minified to one line) instead of/in addition to the key above.
GOOGLE_GENAI_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON_STRING=

# --- Video generation (3 selectable providers - see sceneManager.ts) ---
# ACTIVE_VIDEO_PROVIDER selects the EXCLUSIVE renderer for new scenes. There is
# deliberately NO automatic per-scene fallback between providers - an outage
# on the active one fails visibly (scene status="failed") rather than silently
# switching and masking the problem. Values:
#   "veo"   - Google Veo 3.1 Lite (managed API, native audio). Chosen as the
#             production-quality winner from a Veo Fast vs. Lite vs. Kling
#             comparison - see .agents/memory/veo-lite-integration.md. Uses
#             GOOGLE_GENAI_API_KEY below, no separate secret needed.
#   "wan"   - self-hosted Wan 2.2 (14B, T2V-A14B + I2V-A14B) worker on Vast.ai.
#             Cheapest option; kept as dormant standby infra (see
#             .agents/memory/wan-vast-video-migration.md for its known
#             cold-start caveats before relying on it for live traffic).
#   "kling" - the original Kling AI API. Manual fallback only - flip to this
#             during an extended outage of the active provider.
ACTIVE_VIDEO_PROVIDER=veo
VAST_AI_API_KEY=
# The Vast.ai serverless endpoint NAME (the `endpoint` field in /route/ calls) -
# filled in once the endpoint is provisioned via infra/vast-ai/wan22-provisioning.sh.
VAST_AI_ENDPOINT_ID=
# Optional tuning (sane defaults are hardcoded in wanRenderer.ts if unset):
# VAST_AI_REQUEST_COST=6000
# VAST_AI_MAX_WAIT_SEC=600

# (SUPABASE_S3_* keys are no longer used - the Vast.ai worker uploads via the
# OBJECT_STORAGE_* S3 endpoint above. Removed in the Wasabi migration.)

KLING_API_KEY=

# --- Security ---
TOKEN_ENCRYPTION_KEY=

# --- Google Ads (Campaign Manager import/sync) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web).
# Enable the Google Ads API. Authorized redirect URI:
#   https://dev.usegrowthforge.com/api/auth/google-ads/callback
# Developer token: Google Ads → Tools → API Center (Basic Access is enough to
# sync accounts you own; Standard Access needs Google's approval).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional override. Defaults to https://<current-host>/api/auth/google-ads/callback
# GOOGLE_ADS_REDIRECT_URI=

# --- Meta Ads (Campaign Manager import/sync) + Social Hub page publishing ---
# Meta for Developers app. Add Facebook Login. Valid OAuth Redirect URIs:
#   https://dev.usegrowthforge.com/api/auth/meta-ads/callback   (Campaign Manager)
#   https://dev.usegrowthforge.com/api/auth/meta/callback       (Social Hub pages)
# Request ads_read + business_management for campaign sync.
META_APP_ID=
META_APP_SECRET=
# Optional overrides. Defaults follow the current host as above.
# META_ADS_REDIRECT_URI=
# META_REDIRECT_URI=


# --- Autonomous campaign optimizer (Google Ads + Meta Ads) ---
# Global kill switch. When "true", the optimizer runs its scheduler.
# AUTONOMOUS_OPTIMIZER_ENABLED=true
# observe = record recommendations only (default, safe); act = apply mutations.
# AUTONOMOUS_OPTIMIZER_MODE=observe
# Cron schedule (default hourly).
# AUTONOMOUS_OPTIMIZER_CRON=0 * * * *
# Guardrails (USD / ROAS / minutes). Conservative defaults shown.
# AUTONOMOUS_MIN_DAILY_BUDGET=1
# AUTONOMOUS_MAX_DAILY_BUDGET=200
# AUTONOMOUS_BUDGET_STEP_PCT=0.2
# AUTONOMOUS_ROAS_TARGET=2.0
# AUTONOMOUS_ROAS_FLOOR=1.0
# AUTONOMOUS_PAUSE_SPEND=50
# AUTONOMOUS_DECREASE_SPEND=20
# AUTONOMOUS_COOLDOWN_MINUTES=360

# GrowthForge — Caddy reverse-proxy / static-file config for the dedicated
# GrowthForge Lightsail instance (ca-central-1). Same pattern as
# dev.quantivarian.com: a Basic-Auth-gated, noindexed dev host serving the
# full app, and a public production host that shows a static "Coming Soon"
# page until launch is approved.
#
# Unlike Quantivarian's current (pre-launch) setup, dev and prod here run as
# TWO SEPARATE api-server processes against two separate build directories
# (/home/ubuntu/dev/app vs /home/ubuntu/prod/app) — GrowthForge's active
# video-rendering work needs dev and prod to stay independently deployable
# even after launch, not just until launch day.
#
# Install: sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

# --- DEVELOPMENT (internal only): full app, basic auth, hidden from search. ---
#
# Gate design copied from Quantivarian (dev.quantivarian.com), which is the
# working model: a ONE-TIME Basic Auth challenge that sets a long-lived
# cookie. Plain `basic_auth` on every request (including /api/* and OAuth
# return) makes the browser pop its native credential dialog again — that
# is the "second blocker" after landing-page sign-in.
#
# /api/* is excluded from the gate. Sign-in/sign-up fetch /api/auth/*;
# a Caddy 401 WWW-Authenticate on those calls pops the gf-dev dialog
# again. API routes already require a Supabase session where needed.
#
# /sign-in, /sign-up, and /auth/redirect must also be excluded. Google
# (and email-confirm) return here as a top-level GET. If the gf_gate
# cookie is missing, Caddy's basic_auth challenge swallows the OAuth
# `code` and the SPA never completes sign-in — the user lands back on
# the same page and thinks Continue with Google did nothing.
# Caddy 2.11 treats the bcrypt hash as a literal (do not $$ -escape it).
dev.usegrowthforge.com {
	route {
		@needs_gate {
			not path /api/*
			not path /sign-in
			not path /sign-up
			not path /auth/redirect
			not header_regexp Cookie "gf_gate=9c4e7a1f2b8d6e0c5a3f9b7d1e8c4a6f"
		}
		basic_auth @needs_gate {
			gf-dev $2a$14$WNw5bilgavSqNQLq0O75EeaaoDURZAfX7ROf0EXUYA8EfU56ECN8C
		}
		header Set-Cookie "gf_gate=9c4e7a1f2b8d6e0c5a3f9b7d1e8c4a6f; Path=/; Max-Age=31536000; HttpOnly; Secure; SameSite=Lax"
		header X-Robots-Tag "noindex, nofollow"
		handle /robots.txt {
			root * /home/ubuntu/dev-static
			file_server
		}
		handle /api/* {
			reverse_proxy localhost:4001
		}
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			root * /home/ubuntu/dev/app/artifacts/growthforge/dist/public
			file_server
		}
		handle {
			header Cache-Control "no-cache, no-store, must-revalidate"
			root * /home/ubuntu/dev/app/artifacts/growthforge/dist/public
			try_files {path} /index.html
			file_server
		}
	}
	encode gzip
}

# --- PRODUCTION (pre-launch): serve the "Coming Soon" static page only. ---
# No proxy to the API and no serving of app assets here — the real app is
# fully built and verified on dev.usegrowthforge.com above. At launch time,
# comment out this block and the www redirect below it, then uncomment the
# "LAUNCHED" block further down (or see docs/deployment.md §Promotion).
usegrowthforge.com {
	root * /home/ubuntu/coming-soon
	file_server
	encode gzip
}

www.usegrowthforge.com {
	redir https://usegrowthforge.com{uri} permanent
}

# --- LAUNCHED: uncomment this block (and delete the two blocks above it)
#     once dev has been fully tested and launch is approved. Points at the
#     prod api-server process + the prod build directory — a separate,
#     independently-promoted deployment from dev, not the same process. ---

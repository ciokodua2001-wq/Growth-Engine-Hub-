# --- Fallback: raw IP / unmatched Host header -> Coming Soon, hidden from search. ---
:80 {
	route {
		header X-Robots-Tag "noindex, nofollow"
		root * /home/ubuntu/coming-soon
		file_server
	}
	encode gzip
}

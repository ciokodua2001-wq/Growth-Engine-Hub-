# GrowthForge — dev slot environment (/home/ubuntu/dev/app/.env on the Lightsail box).
# Copy the real values from the root .env.example / your password manager.
# Only the lines called out below differ from the prod slot — everything
# else (Supabase project, DATABASE_URL, Stripe, etc.) is intentionally
# IDENTICAL, since dev and prod share one Supabase project.

APP_ENV=development
PORT=4001

# --- Supabase (SAME project as prod — see docs/deployment.md §Architecture) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Supabase Storage — DEV-ONLY path prefixes ---
# Isolates dev video-render jobs/assets from prod within the same bucket,
# per "Development rendering jobs, files, and assets should remain isolated."
# DEFAULT_OBJECT_STORAGE_BUCKET_ID is the actual bucket name (SAME for dev+prod —
# create it once in Supabase Storage, non-public); the two paths below are just
# prefixes within it.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=growthforge
PUBLIC_OBJECT_SEARCH_PATHS=growthforge/dev/public
PRIVATE_OBJECT_DIR=growthforge/dev/private

# --- Payments (Stripe TEST keys recommended for dev) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google AI (SAME project as prod — Gemini/Imagen text+image, Cloud TTS narration) ---
GOOGLE_GENAI_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON_STRING=

# --- Video generation (SAME project as prod — self-hosted Wan 2.7 worker on Vast.ai) ---
ACTIVE_VIDEO_PROVIDER=wan
VAST_AI_API_KEY=
VAST_AI_ENDPOINT_ID=
KLING_API_KEY=

# --- Security ---
TOKEN_ENCRYPTION_KEY=

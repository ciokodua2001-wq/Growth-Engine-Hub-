# GrowthForge — prod slot environment (/home/ubuntu/prod/app/.env on the Lightsail box).
# Copy the real values from the root .env.example / your password manager.

APP_ENV=production
PORT=4002

# --- Supabase (SAME project as dev — see docs/deployment.md §Architecture) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Supabase Storage — PROD-ONLY path prefixes (never share with dev) ---
# DEFAULT_OBJECT_STORAGE_BUCKET_ID is the actual bucket name (SAME as dev —
# it's one shared bucket, isolated by the path prefixes below).
DEFAULT_OBJECT_STORAGE_BUCKET_ID=growthforge
PUBLIC_OBJECT_SEARCH_PATHS=growthforge/prod/public
PRIVATE_OBJECT_DIR=growthforge/prod/private

# --- Payments (Stripe LIVE keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google AI (SAME project as dev — Gemini/Imagen text+image, Cloud TTS narration) ---
GOOGLE_GENAI_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON_STRING=

# --- Video generation (SAME project as dev — self-hosted Wan 2.7 worker on Vast.ai) ---
ACTIVE_VIDEO_PROVIDER=wan
VAST_AI_API_KEY=
VAST_AI_ENDPOINT_ID=
KLING_API_KEY=

# --- Security ---
TOKEN_ENCRYPTION_KEY=

[Unit]
Description=GrowthForge FFmpeg assembly worker (dev)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/dev/app/artifacts/api-server
EnvironmentFile=/home/ubuntu/dev/app/.env
Environment=APP_ENV=development
Environment=FFMPEG_WORKER_ID=dev-worker-1
Environment=FFMPEG_WORKER_STALE_CLAIM_MS=5000
# Lower priority than the API so FFmpeg encodes yield CPU to interactive traffic
# under contention, but still run at full speed when the API is idle.
Nice=10
ExecStart=/usr/bin/node --enable-source-maps dist/ffmpeg-worker.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

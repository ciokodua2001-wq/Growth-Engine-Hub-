{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProvisionLTXWorker",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1:975356610033:instance/*",
        "arn:aws:ec2:us-east-1:975356610033:network-interface/*",
        "arn:aws:ec2:us-east-1:975356610033:security-group/*",
        "arn:aws:ec2:us-east-1:975356610033:subnet/*",
        "arn:aws:ec2:us-east-1:975356610033:volume/*",
        "arn:aws:ec2:us-east-1:975356610033:key-pair/*",
        "arn:aws:ec2:us-east-1:975356610033:image/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:InstanceType": ["g6e.2xlarge", "g6e.4xlarge"],
          "aws:RequestTag/ltx": "worker"
        }
      }
    },
    {
      "Sid": "ManageLTXInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:CreateTags",
        "ec2:GetConsoleOutput"
      ],
      "Resource": "arn:aws:ec2:us-east-1:975356610033:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/ltx": "worker"
        }
      }
    },
    {
      "Sid": "CreateLTXVolumes",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:aws:ec2:us-east-1:975356610033:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/ltx": "worker"
        }
      }
    },
    {
      "Sid": "ManageLTXVolumes",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume",
        "ec2:CreateSnapshot",
        "ec2:DeleteSnapshot"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:975356610033:volume/*",
        "arn:aws:ec2:us-east-1:975356610033:snapshot/*",
        "arn:aws:ec2:us-east-1:975356610033:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/ltx": "worker"
        }
      }
    },
    {
      "Sid": "DescribeEC2",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeImages",
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeTags",
        "ec2:DescribeRegions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" }
      }
    },
    {
      "Sid": "LTXSupportResources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateKeyPair",
        "ec2:ImportKeyPair",
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:975356610033:key-pair/*",
        "arn:aws:ec2:us-east-1:975356610033:security-group/*"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" }
      }
    },
    {
      "Sid": "PassInstanceRoleOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::975356610033:role/ltx-worker-instance-role",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" }
      }
    },
    {
      "Sid": "LTXS3",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::gf-ltx-output",
        "arn:aws:s3:::gf-ltx-output/*",
        "arn:aws:s3:::gf-ltx-models",
        "arn:aws:s3:::gf-ltx-models/*"
      ]
    },
    {
      "Sid": "LTXLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:975356610033:log-group:/aws/ltx/*"
    },
    {
      "Sid": "LTXStopAlarm",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" }
      }
    }
  ]
}

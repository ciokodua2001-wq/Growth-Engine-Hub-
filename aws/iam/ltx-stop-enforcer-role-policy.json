{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FindWorkers",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "StopWorkers",
      "Effect": "Allow",
      "Action": "ec2:StopInstances",
      "Resource": "arn:aws:ec2:us-east-1:975356610033:instance/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/ltx": "worker" }
      }
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:975356610033:log-group:/aws/lambda/ltx-stop-enforcer*"
    }
  ]
}

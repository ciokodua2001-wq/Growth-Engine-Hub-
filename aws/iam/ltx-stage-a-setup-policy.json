{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateBoundedRole",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::975356610033:role/ltx-*",
      "Condition": {
        "StringEquals": { "iam:PermissionsBoundary": "arn:aws:iam::975356610033:policy/ltx-boundary" }
      }
    },
    {
      "Sid": "ManageRolesProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:GetRole",
        "iam:GetInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::975356610033:role/ltx-*",
        "arn:aws:iam::975356610033:instance-profile/ltx-*"
      ]
    },
    {
      "Sid": "PassRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::975356610033:role/ltx-worker-instance-role",
        "arn:aws:iam::975356610033:role/ltx-stop-enforcer-role"
      ],
      "Condition": {
        "StringEquals": { "iam:PassedToService": ["ec2.amazonaws.com", "lambda.amazonaws.com"] }
      }
    },
    {
      "Sid": "CreateBuckets",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::gf-ltx-*"
    },
    {
      "Sid": "CreateLambda",
      "Effect": "Allow",
      "Action": ["lambda:CreateFunction", "lambda:AddPermission", "lambda:GetFunction"],
      "Resource": "arn:aws:lambda:us-east-1:975356610033:function:ltx-*"
    },
    {
      "Sid": "CreateRule",
      "Effect": "Allow",
      "Action": ["events:PutRule", "events:PutTargets"],
      "Resource": "arn:aws:events:us-east-1:975356610033:rule/ltx-*"
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateBoundedRole",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": [
        "arn:aws:iam::975356610033:role/ltx-worker-instance-role",
        "arn:aws:iam::975356610033:role/ltx-stop-enforcer-role"
      ],
      "Condition": {
        "StringEquals": { "iam:PermissionsBoundary": "arn:aws:iam::975356610033:policy/ltx-boundary" }
      }
    },
    {
      "Sid": "ManageRolesProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:PutRolePolicy",
        "iam:GetRole",
        "iam:GetInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::975356610033:role/ltx-worker-instance-role",
        "arn:aws:iam::975356610033:role/ltx-stop-enforcer-role",
        "arn:aws:iam::975356610033:instance-profile/ltx-worker-instance-profile"
      ]
    },
    {
      "Sid": "AttachSSMCoreOnly",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::975356610033:role/ltx-worker-instance-role",
      "Condition": {
        "ArnEquals": { "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore" }
      }
    },
    {
      "Sid": "PassWorkerRoleToEC2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::975356610033:role/ltx-worker-instance-role",
      "Condition": { "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" } }
    },
    {
      "Sid": "PassEnforcerRoleToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::975356610033:role/ltx-stop-enforcer-role",
      "Condition": { "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" } }
    },
    {
      "Sid": "CreateBuckets",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": [
        "arn:aws:s3:::gf-ltx-output",
        "arn:aws:s3:::gf-ltx-models"
      ]
    },
    {
      "Sid": "CreateEnforcerLambda",
      "Effect": "Allow",
      "Action": ["lambda:CreateFunction", "lambda:GetFunction"],
      "Resource": "arn:aws:lambda:us-east-1:975356610033:function:ltx-stop-enforcer"
    },
    {
      "Sid": "GrantEventBridgeInvoke",
      "Effect": "Allow",
      "Action": "lambda:AddPermission",
      "Resource": "arn:aws:lambda:us-east-1:975356610033:function:ltx-stop-enforcer",
      "Condition": {
        "StringEquals": {
          "lambda:Principal": "events.amazonaws.com",
          "lambda:SourceArn": "arn:aws:events:us-east-1:975356610033:rule/ltx-stop-enforcer"
        }
      }
    },
    {
      "Sid": "CreateRule",
      "Effect": "Allow",
      "Action": ["events:PutRule", "events:PutTargets"],
      "Resource": "arn:aws:events:us-east-1:975356610033:rule/ltx-stop-enforcer"
    },
    {
      "Sid": "VerifyEnforcerChain",
      "Effect": "Allow",
      "Action": ["lambda:GetPolicy", "lambda:InvokeFunction", "events:DescribeRule", "events:ListTargetsByRule"],
      "Resource": [
        "arn:aws:lambda:us-east-1:975356610033:function:ltx-stop-enforcer",
        "arn:aws:events:us-east-1:975356610033:rule/ltx-stop-enforcer"
      ]
    }
  ]
}
